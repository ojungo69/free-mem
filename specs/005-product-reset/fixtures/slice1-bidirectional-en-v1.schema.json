{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://free-mem.dev/specs/005-product-reset/fixtures/slice1-bidirectional-en-v1.schema.json",
  "title": "Product Reset Slice 1 bidirectional fixture v1",
  "$comment": "Structural layer only. Run validate-slice1-fixture.mjs for canonical contract conformance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixtureVersion", "schema", "fixtureId", "ownerSlice", "language", "factMatch", "contractFingerprint", "pins", "effectiveConfiguration", "kindContract", "environment", "lifecycleProfiles", "samplingProtocol", "thresholds", "scenarios"],
  "properties": {
    "fixtureVersion": { "const": 1 },
    "schema": { "const": "slice1-bidirectional-en-v1.schema.json" },
    "fixtureId": { "$ref": "#/$defs/NonEmptyString" },
    "ownerSlice": { "const": 1 },
    "language": { "$ref": "#/$defs/NonEmptyString" },
    "factMatch": { "const": "exact" },
    "contractFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "pins": { "$ref": "#/$defs/Pins" },
    "effectiveConfiguration": { "$ref": "#/$defs/EffectiveConfiguration" },
    "kindContract": { "$ref": "#/$defs/KindContract" },
    "environment": { "$ref": "#/$defs/Environment" },
    "lifecycleProfiles": { "$ref": "#/$defs/LifecycleProfiles" },
    "samplingProtocol": { "$ref": "#/$defs/SamplingProtocol" },
    "thresholds": { "$ref": "#/$defs/Thresholds" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Scenario" }
    }
  },
  "$defs": {
    "NonEmptyString": { "type": "string", "minLength": 1 },
    "NonNegativeInteger": { "type": "integer", "minimum": 0 },
    "PositiveInteger": { "type": "integer", "minimum": 1 },
    "Agent": { "enum": ["claude-code", "codex"] },
    "EventKind": { "enum": ["prompt", "tool_activity", "tool_result", "assistant_message", "session_boundary"] },
    "Pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeMemBaseCommit", "claudeCodeVersion", "codexVersion", "nodeVersion", "pnpmVersion", "summaryProviderStub"],
      "properties": {
        "freeMemBaseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "claudeCodeVersion": { "$ref": "#/$defs/NonEmptyString" },
        "codexVersion": { "$ref": "#/$defs/NonEmptyString" },
        "nodeVersion": { "$ref": "#/$defs/NonEmptyString" },
        "pnpmVersion": { "$ref": "#/$defs/NonEmptyString" },
        "summaryProviderStub": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "EffectiveConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceProfile", "summaryProvider", "embeddingProvider"],
      "properties": {
        "resourceProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileId", "version", "processingRetryLimit", "maxMemoryItemsPerDerivation", "injectionEnvelope"],
          "properties": {
            "profileId": { "$ref": "#/$defs/NonEmptyString" },
            "version": { "$ref": "#/$defs/PositiveInteger" },
            "processingRetryLimit": { "$ref": "#/$defs/PositiveInteger" },
            "maxMemoryItemsPerDerivation": { "$ref": "#/$defs/PositiveInteger" },
            "injectionEnvelope": { "$ref": "#/$defs/InjectionEnvelope" }
          }
        },
        "summaryProvider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "providerId", "configurationFingerprint", "executionLocation", "endpointScheme", "endpointHost", "credentialSource", "tlsCertificateValidation", "redirectPolicy"],
          "properties": {
            "state": { "const": "enabled" },
            "providerId": { "$ref": "#/$defs/NonEmptyString" },
            "configurationFingerprint": { "$ref": "#/$defs/NonEmptyString" },
            "executionLocation": { "enum": ["local", "remote"] },
            "endpointScheme": { "const": "https" },
            "endpointHost": { "$ref": "#/$defs/NonEmptyString" },
            "credentialSource": { "$ref": "#/$defs/NonEmptyString" },
            "tlsCertificateValidation": { "const": "required" },
            "redirectPolicy": { "const": "reject" }
          }
        },
        "embeddingProvider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason", "packDegradationReason"],
          "properties": {
            "state": { "const": "disabled" },
            "reason": { "$ref": "#/$defs/NonEmptyString" },
            "packDegradationReason": { "const": "semantic_disabled" }
          }
        }
      }
    },
    "LaneBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minItems", "maxItems"],
      "properties": {
        "minItems": { "$ref": "#/$defs/NonNegativeInteger" },
        "maxItems": { "$ref": "#/$defs/NonNegativeInteger" }
      }
    },
    "InjectionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionTimeBudgetMs", "admittedCandidateLimit", "maxRenderedBytes", "maxSelectedItems", "maxInjectedTokens", "laneBudgets"],
      "properties": {
        "selectionTimeBudgetMs": { "$ref": "#/$defs/PositiveInteger" },
        "admittedCandidateLimit": { "$ref": "#/$defs/PositiveInteger" },
        "maxRenderedBytes": { "$ref": "#/$defs/PositiveInteger" },
        "maxSelectedItems": { "$ref": "#/$defs/PositiveInteger" },
        "maxInjectedTokens": { "$ref": "#/$defs/PositiveInteger" },
        "laneBudgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact_session", "lexical", "semantic", "recency"],
          "properties": {
            "exact_session": { "$ref": "#/$defs/LaneBudget" },
            "lexical": { "$ref": "#/$defs/LaneBudget" },
            "semantic": { "$ref": "#/$defs/LaneBudget" },
            "recency": { "$ref": "#/$defs/LaneBudget" }
          }
        }
      }
    },
    "KindContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedEventKinds", "memoryItemKinds"],
      "properties": {
        "capturedEventKinds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/EventKind" } },
        "memoryItemKinds": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["summary", "decision", "discovery", "change", "failed_approach", "next_action"] }
        }
      }
    },
    "Environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "dataDir", "repository", "network"],
      "properties": {
        "home": { "$ref": "#/$defs/NonEmptyString" },
        "dataDir": { "$ref": "#/$defs/NonEmptyString" },
        "repository": { "$ref": "#/$defs/NonEmptyString" },
        "network": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "LifecycleProfiles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "MetricSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarios", "sampleBoundary"],
      "properties": {
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/NonEmptyString" } },
        "sampleBoundary": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "ResourceMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioSelection", "startMilestone", "endMilestone", "sampleSubject", "aggregation"],
      "properties": {
        "scenarioSelection": { "const": "all" },
        "startMilestone": { "$ref": "#/$defs/NonEmptyString" },
        "endMilestone": { "$ref": "#/$defs/NonEmptyString" },
        "sampleSubject": { "enum": ["product_root_and_descendants", "memory_processing_queue", "isolated_data_directory"] },
        "aggregation": { "enum": ["maximum_concurrent_process_count", "maximum_rss_mib_minus_start_rss_mib", "maximum_queue_depth", "end_bytes_minus_start_bytes", "process_count_at_end"] }
      },
      "oneOf": [
        { "properties": { "sampleSubject": { "const": "product_root_and_descendants" }, "aggregation": { "const": "maximum_concurrent_process_count" } } },
        { "properties": { "sampleSubject": { "const": "product_root_and_descendants" }, "aggregation": { "const": "maximum_rss_mib_minus_start_rss_mib" } } },
        { "properties": { "sampleSubject": { "const": "memory_processing_queue" }, "aggregation": { "const": "maximum_queue_depth" } } },
        { "properties": { "sampleSubject": { "const": "isolated_data_directory" }, "aggregation": { "const": "end_bytes_minus_start_bytes" } } },
        { "properties": { "sampleSubject": { "const": "product_root_and_descendants" }, "aggregation": { "const": "process_count_at_end" } } }
      ]
    },
    "SamplingProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runsPerScenario", "discardInitialRunsPerScenario", "measuredRunsPerScenario", "percentileMethod", "percentileScope", "clock", "coldReset", "warmState", "processSampleIntervalMs", "metrics", "resourceMetrics"],
      "properties": {
        "runsPerScenario": { "$ref": "#/$defs/PositiveInteger" },
        "discardInitialRunsPerScenario": { "$ref": "#/$defs/NonNegativeInteger" },
        "measuredRunsPerScenario": { "$ref": "#/$defs/PositiveInteger" },
        "percentileMethod": { "$ref": "#/$defs/NonEmptyString" },
        "percentileScope": { "$ref": "#/$defs/NonEmptyString" },
        "clock": { "$ref": "#/$defs/NonEmptyString" },
        "coldReset": { "$ref": "#/$defs/NonEmptyString" },
        "warmState": { "$ref": "#/$defs/NonEmptyString" },
        "processSampleIntervalMs": { "$ref": "#/$defs/PositiveInteger" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["captureP95Ms", "warmInjectionP95Ms", "shortColdLexicalInjectionMs"],
          "properties": {
            "captureP95Ms": { "$ref": "#/$defs/MetricSample" },
            "warmInjectionP95Ms": { "$ref": "#/$defs/MetricSample" },
            "shortColdLexicalInjectionMs": { "$ref": "#/$defs/MetricSample" }
          }
        },
        "resourceMetrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxSteadyProductProcessCount", "maxShortRunRssGrowthMiB", "maxPendingQueueDepth", "maxStorageGrowthBytes", "orphanProductProcessCount"],
          "properties": {
            "maxSteadyProductProcessCount": { "allOf": [
              { "$ref": "#/$defs/ResourceMetric" },
              { "properties": { "startMilestone": { "const": "source_session_started" }, "endMilestone": { "const": "scenario_terminal" }, "sampleSubject": { "const": "product_root_and_descendants" }, "aggregation": { "const": "maximum_concurrent_process_count" } } }
            ] },
            "maxShortRunRssGrowthMiB": { "allOf": [
              { "$ref": "#/$defs/ResourceMetric" },
              { "properties": { "startMilestone": { "const": "source_session_started" }, "endMilestone": { "const": "scenario_terminal" }, "sampleSubject": { "const": "product_root_and_descendants" }, "aggregation": { "const": "maximum_rss_mib_minus_start_rss_mib" } } }
            ] },
            "maxPendingQueueDepth": { "allOf": [
              { "$ref": "#/$defs/ResourceMetric" },
              { "properties": { "startMilestone": { "const": "source_session_started" }, "endMilestone": { "const": "scenario_terminal" }, "sampleSubject": { "const": "memory_processing_queue" }, "aggregation": { "const": "maximum_queue_depth" } } }
            ] },
            "maxStorageGrowthBytes": { "allOf": [
              { "$ref": "#/$defs/ResourceMetric" },
              { "properties": { "startMilestone": { "const": "source_session_started" }, "endMilestone": { "const": "scenario_terminal" }, "sampleSubject": { "const": "isolated_data_directory" }, "aggregation": { "const": "end_bytes_minus_start_bytes" } } }
            ] },
            "orphanProductProcessCount": { "allOf": [
              { "$ref": "#/$defs/ResourceMetric" },
              { "properties": { "startMilestone": { "const": "scenario_terminal" }, "endMilestone": { "const": "post_teardown_grace_elapsed" }, "sampleSubject": { "const": "product_root_and_descendants" }, "aggregation": { "const": "process_count_at_end" } } }
            ] }
          }
        }
      }
    },
    "Thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captureP95Ms", "warmInjectionP95Ms", "shortColdLexicalInjectionMs", "maxSteadyProductProcessCount", "orphanProductProcessCount", "maxShortRunRssGrowthMiB", "maxPendingQueueDepth", "maxStorageGrowthBytes", "maxInjectedTokens", "agentBlockageCount", "acceptedEventLossCount", "duplicateDurableMemoryCount", "secretEgressCount", "incompatibleScopeInjectionCount"],
      "properties": {
        "captureP95Ms": { "$ref": "#/$defs/NonNegativeInteger" },
        "warmInjectionP95Ms": { "$ref": "#/$defs/NonNegativeInteger" },
        "shortColdLexicalInjectionMs": { "$ref": "#/$defs/NonNegativeInteger" },
        "maxSteadyProductProcessCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "orphanProductProcessCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "maxShortRunRssGrowthMiB": { "$ref": "#/$defs/NonNegativeInteger" },
        "maxPendingQueueDepth": { "$ref": "#/$defs/NonNegativeInteger" },
        "maxStorageGrowthBytes": { "$ref": "#/$defs/NonNegativeInteger" },
        "maxInjectedTokens": { "$ref": "#/$defs/NonNegativeInteger" },
        "agentBlockageCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "acceptedEventLossCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "duplicateDurableMemoryCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "secretEgressCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "incompatibleScopeInjectionCount": { "$ref": "#/$defs/NonNegativeInteger" }
      }
    },
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "sourceAgent", "targetAgent", "sourceRepositoryScope", "targetRepositoryScope", "lifecycleProfileId", "resourceSampleMode", "retrievalQuery", "events", "summaryProviderStub", "drainCondition", "expectedInjectedItems", "expectedOmissions", "forbiddenFacts", "expectedCounters"],
      "properties": {
        "scenarioId": { "$ref": "#/$defs/NonEmptyString" },
        "sourceAgent": { "$ref": "#/$defs/Agent" },
        "targetAgent": { "$ref": "#/$defs/Agent" },
        "sourceRepositoryScope": { "$ref": "#/$defs/NonEmptyString" },
        "targetRepositoryScope": { "$ref": "#/$defs/NonEmptyString" },
        "lifecycleProfileId": { "$ref": "#/$defs/NonEmptyString" },
        "resourceSampleMode": { "enum": ["cold", "warm"] },
        "derivationProviderExecutionLocation": { "const": "local" },
        "targetExecutionLocation": { "enum": ["local", "remote"] },
        "retrievalQuery": { "$ref": "#/$defs/NonEmptyString" },
        "fault": { "$ref": "#/$defs/Fault" },
        "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Event" } },
        "summaryProviderStub": { "$ref": "#/$defs/SummaryProviderStub" },
        "drainCondition": { "$ref": "#/$defs/DrainCondition" },
        "expectedOperationalStatus": { "$ref": "#/$defs/ExpectedOperationalStatus" },
        "expectedInjectedItems": { "type": "array", "items": { "$ref": "#/$defs/ExpectedInjectedItem" } },
        "expectedOmissions": { "type": "array", "items": { "$ref": "#/$defs/ExpectedOmission" } },
        "forbiddenFacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/NonEmptyString" } },
        "securityOracle": { "$ref": "#/$defs/SecurityOracle" },
        "expectedCounters": { "$ref": "#/$defs/ExpectedCounters" }
      },
      "oneOf": [
        {
          "required": ["derivationProviderExecutionLocation", "targetExecutionLocation", "securityOracle"]
        },
        {
          "properties": {
            "derivationProviderExecutionLocation": false,
            "targetExecutionLocation": false
          }
        }
      ]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "sequence", "kind", "sensitivity", "redactedPayload", "payloadDigestVersion", "text"],
      "properties": {
        "eventId": { "$ref": "#/$defs/NonEmptyString" },
        "sequence": { "$ref": "#/$defs/PositiveInteger" },
        "kind": { "$ref": "#/$defs/EventKind" },
        "sensitivity": { "enum": ["eligible", "local_only", "private", "secret"] },
        "redactedPayload": { "type": "string" },
        "payloadDigestVersion": { "const": "event-payload-digest-v1" },
        "text": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "ExpectedInjectedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "memoryKind", "sourceEventIds", "sourceSpans", "sensitivity", "sourceLane", "selectionReason"],
      "properties": {
        "fact": { "$ref": "#/$defs/NonEmptyString" },
        "memoryKind": { "enum": ["summary", "decision", "discovery", "change", "failed_approach", "next_action"] },
        "sourceEventIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/NonEmptyString" } },
        "sourceSpans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SourceSpan" } },
        "sensitivity": { "enum": ["eligible", "local_only", "private"] },
        "sourceLane": { "enum": ["exact_session", "lexical"] },
        "selectionReason": { "enum": ["exact_session", "lexical"] }
      }
    },
    "ExpectedOmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "memoryKind", "sourceEventIds", "sourceSpans", "sensitivity", "reason"],
      "properties": {
        "fact": { "$ref": "#/$defs/NonEmptyString" },
        "memoryKind": { "enum": ["summary", "decision", "discovery", "change", "failed_approach", "next_action"] },
        "sourceEventIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/NonEmptyString" } },
        "sourceSpans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SourceSpan" } },
        "sensitivity": { "enum": ["eligible", "local_only", "private"] },
        "reason": { "enum": ["duplicate_revision", "omitted_budget", "omitted_ineligible"] }
      }
    },
    "MemoryDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "body", "sourceEventIds", "sourceSpans"],
      "properties": {
        "kind": { "enum": ["decision", "discovery", "change", "failed_approach", "next_action"] },
        "title": { "$ref": "#/$defs/NonEmptyString" },
        "body": { "$ref": "#/$defs/NonEmptyString" },
        "sourceEventIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/NonEmptyString" } },
        "sourceSpans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SourceSpan" } }
      }
    },
    "SummaryDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "sourceEventIds", "sourceSpans"],
      "properties": {
        "title": { "$ref": "#/$defs/NonEmptyString" },
        "body": { "$ref": "#/$defs/NonEmptyString" },
        "sourceEventIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/NonEmptyString" } },
        "sourceSpans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SourceSpan" } }
      }
    },
    "SourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "startByte", "endByte"],
      "properties": {
        "eventId": { "$ref": "#/$defs/NonEmptyString" },
        "startByte": { "$ref": "#/$defs/NonNegativeInteger" },
        "endByte": { "$ref": "#/$defs/PositiveInteger" }
      }
    },
    "SummaryProviderStub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryItems"],
      "properties": {
        "summary": { "$ref": "#/$defs/SummaryDraft" },
        "malformedResponse": { "$ref": "#/$defs/NonEmptyString" },
        "policyRejectedReason": { "$ref": "#/$defs/NonEmptyString" },
        "redirectResponse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "location"],
          "properties": {
            "status": { "enum": [301, 302, 303, 307, 308] },
            "location": { "$ref": "#/$defs/NonEmptyString" }
          }
        },
        "memoryItems": { "type": "array", "items": { "$ref": "#/$defs/MemoryDraft" } }
      },
      "oneOf": [
        { "required": ["summary"] },
        { "required": ["malformedResponse"] },
        { "required": ["redirectResponse"] },
        { "required": ["policyRejectedReason"] }
      ]
    },
    "Fault": {
      "oneOf": [
        { "$ref": "#/$defs/DaemonUnavailableFault" },
        { "$ref": "#/$defs/SummaryProviderMalformedFault" },
        { "$ref": "#/$defs/SummaryProviderRedirectFault" },
        { "$ref": "#/$defs/LocalOnlyProviderFault" }
      ]
    },
    "DaemonUnavailableFault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "recovery", "replaySchedule", "identityConflictProbe"],
      "properties": {
        "kind": { "const": "daemon_unavailable_after_event_accept" },
        "recovery": { "const": "restart_and_replay_same_batch_twice" },
        "replaySchedule": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/ReplayAttempt" } },
        "identityConflictProbe": { "$ref": "#/$defs/IdentityConflictProbe" }
      }
    },
    "SummaryProviderMalformedFault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "attemptsUntilExhausted", "resumeCasesAreIndependent", "resumeCaseInitialSnapshot", "recoveredOutput", "resumeCases"],
      "properties": {
        "kind": { "const": "summary_provider_malformed_response" },
        "attemptsUntilExhausted": { "$ref": "#/$defs/PositiveInteger" },
        "resumeCasesAreIndependent": { "const": true },
        "resumeCaseInitialSnapshot": {
          "const": { "state": "retry-exhausted", "budget": 0, "lastConsumedSequence": 0 }
        },
        "recoveredOutput": { "$ref": "#/$defs/SummaryProviderStub" },
        "resumeCases": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/ResumeCase" } }
      }
    },
    "SummaryProviderRedirectFault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "recoveredOutput", "redirectRecovery"],
      "properties": {
        "kind": { "const": "summary_provider_redirect_response" },
        "recoveredOutput": { "$ref": "#/$defs/SummaryProviderStub" },
        "redirectRecovery": { "$ref": "#/$defs/RedirectRecovery" }
      }
    },
    "LocalOnlyProviderFault": {
      "const": { "kind": "local_only_remote_provider_ineligible" }
    },
    "ReplayAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "eventIds"],
      "properties": {
        "attempt": { "$ref": "#/$defs/PositiveInteger" },
        "eventIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/NonEmptyString" } }
      }
    },
    "IdentityConflictProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "digestInput", "payloadDigestVersion", "canonicalPayloadDigest", "conflictingRedactedPayload", "conflictingPayloadDigest", "canonicalEventState", "incomingDeliveryState", "expectedReason", "canonicalPayloadUnchanged", "durableMemoryDelta"],
      "properties": {
        "eventId": { "$ref": "#/$defs/NonEmptyString" },
        "digestInput": { "const": "domain_separated_jcs_redacted_payload_v1" },
        "payloadDigestVersion": { "const": "event-payload-digest-v1" },
        "canonicalPayloadDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "conflictingRedactedPayload": { "$ref": "#/$defs/NonEmptyString" },
        "conflictingPayloadDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "canonicalEventState": { "const": "committed" },
        "incomingDeliveryState": { "const": "quarantined" },
        "expectedReason": { "const": "event_identity_payload_conflict" },
        "canonicalPayloadUnchanged": { "const": true },
        "durableMemoryDelta": { "const": 0 }
      }
    },
    "ResumeSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signalId", "sequence", "kind", "targetRole", "providerChoiceId", "configurationFingerprint"],
      "properties": {
        "signalId": { "$ref": "#/$defs/NonEmptyString" },
        "sequence": { "$ref": "#/$defs/PositiveInteger" },
        "kind": { "enum": ["validated_configuration_activation", "recorded_provider_healthy_transition", "user_confirmed_doctor_retry"] },
        "targetRole": { "const": "summary" },
        "providerChoiceId": { "const": "deterministic-summary-v1" },
        "configurationFingerprint": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "ResumeExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budgetBefore", "budgetAfterGrant", "budgetAfterAttempt", "attemptDelta", "lastConsumedSequence", "ignoredSignalCount", "finalState", "durableMemoryCount"],
      "properties": {
        "budgetBefore": { "$ref": "#/$defs/NonNegativeInteger" },
        "budgetAfterGrant": { "$ref": "#/$defs/NonNegativeInteger" },
        "budgetAfterAttempt": { "$ref": "#/$defs/NonNegativeInteger" },
        "attemptDelta": { "$ref": "#/$defs/NonNegativeInteger" },
        "lastConsumedSequence": { "$ref": "#/$defs/NonNegativeInteger" },
        "ignoredSignalCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "finalState": { "enum": ["completed", "retry-exhausted"] },
        "durableMemoryCount": { "$ref": "#/$defs/NonNegativeInteger" }
      }
    },
    "ResumeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "signals", "providerOutcome", "expected"],
      "properties": {
        "caseId": { "$ref": "#/$defs/NonEmptyString" },
        "signals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ResumeSignal" } },
        "providerOutcome": { "enum": ["valid", "malformed"] },
        "expected": { "$ref": "#/$defs/ResumeExpected" }
      }
    },
    "RedirectRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "oldLocationRequestCountAfterActivation", "providerOutcome", "expected"],
      "properties": {
        "signal": { "$ref": "#/$defs/ResumeSignal" },
        "oldLocationRequestCountAfterActivation": { "const": 0 },
        "providerOutcome": { "const": "valid" },
        "expected": { "$ref": "#/$defs/ResumeExpected" }
      }
    },
    "DrainCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drainConditionId", "timeoutMs", "committedEventCount", "summaryCount", "durableMemoryCount", "targetInjectionAcknowledged"],
      "properties": {
        "drainConditionId": { "$ref": "#/$defs/NonEmptyString" },
        "timeoutMs": { "$ref": "#/$defs/PositiveInteger" },
        "committedEventCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "spooledEventCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "replayCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "summaryCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "durableMemoryCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "pendingSummaryJobCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "eventDeliveryState": { "const": "committed" },
        "summaryJobState": { "const": "retry-exhausted" },
        "redirectLocationRequestCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "resentPayloadCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "providerRequestCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "providerPayloadCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "targetInjectionAcknowledged": { "type": "boolean" }
      }
    },
    "ExpectedOperationalStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "state", "reason", "pendingCount", "safeAction", "profileId", "profileVersion"],
      "properties": {
        "component": { "const": "summary" },
        "state": { "const": "failed" },
        "reason": { "$ref": "#/$defs/NonEmptyString" },
        "pendingCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "safeAction": { "$ref": "#/$defs/NonEmptyString" },
        "profileId": { "$ref": "#/$defs/NonEmptyString" },
        "profileVersion": { "$ref": "#/$defs/PositiveInteger" }
      }
    },
    "SecurityOracle": {
      "oneOf": [
        { "$ref": "#/$defs/RemoteEgressSecurityOracle" },
        { "$ref": "#/$defs/CrossScopeSecurityOracle" },
        { "$ref": "#/$defs/DerivedSensitivitySecurityOracle" }
      ]
    },
    "RemoteEgressSecurityOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consideredRemoteProviderEventCount", "consideredSecretEventCount", "remoteProviderRequestCount", "remoteProviderPayloadCount", "persistedSecretCount", "injectedSecretCount", "forbiddenSentinels", "sentinelObservedAtRemote", "secretObservedInPersistenceOrInjection"],
      "properties": {
        "consideredRemoteProviderEventCount": { "$ref": "#/$defs/PositiveInteger" },
        "consideredSecretEventCount": { "$ref": "#/$defs/PositiveInteger" },
        "remoteProviderRequestCount": { "const": 0 },
        "remoteProviderPayloadCount": { "const": 0 },
        "persistedSecretCount": { "const": 0 },
        "injectedSecretCount": { "const": 0 },
        "forbiddenSentinels": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/NonEmptyString" } },
        "sentinelObservedAtRemote": { "const": false },
        "secretObservedInPersistenceOrInjection": { "const": false }
      }
    },
    "CrossScopeSecurityOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consideredCrossScopeCandidateCount", "incompatibleScopeInjectionCount", "forbiddenSentinels", "sentinelObservedInInjection"],
      "properties": {
        "consideredCrossScopeCandidateCount": { "$ref": "#/$defs/PositiveInteger" },
        "incompatibleScopeInjectionCount": { "const": 0 },
        "forbiddenSentinels": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/NonEmptyString" } },
        "sentinelObservedInInjection": { "const": false }
      }
    },
    "DerivedSensitivitySecurityOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consideredDerivedCandidateCount", "remoteInjectionCount", "expectedSensitivity", "forbiddenSentinels", "sentinelObservedInInjection"],
      "properties": {
        "consideredDerivedCandidateCount": { "$ref": "#/$defs/PositiveInteger" },
        "remoteInjectionCount": { "const": 0 },
        "expectedSensitivity": { "const": "local_only" },
        "forbiddenSentinels": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/NonEmptyString" } },
        "sentinelObservedInInjection": { "const": false }
      }
    },
    "ExpectedCounters": {
      "const": {
        "agentBlockageCount": 0,
        "acceptedEventLossCount": 0,
        "duplicateDurableMemoryCount": 0,
        "secretEgressCount": 0,
        "incompatibleScopeInjectionCount": 0
      }
    }
  }
}
